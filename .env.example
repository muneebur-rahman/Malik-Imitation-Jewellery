# ==============================================================================
# MALIK IMITATION JEWELLERY - ENVIRONMENT VARIABLES
# ==============================================================================
# Instructions:
# 1. Copy this file to a new file named .env (in the root directory)
# 2. Replace the placeholder values below with your real Supabase credentials.
# 3. Restart your Vite dev server (`npm run dev`)
# ==============================================================================

# Your Supabase Project URL (Found under Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon Public Key (Found under Project Settings -> API -> Project API keys -> anon/public)
# NOTE: Never put the service_role key here! Only use the anon (public) key.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
